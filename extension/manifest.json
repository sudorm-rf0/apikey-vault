{
  "manifest_version": 3,
  "name": "apikey-vault Guard",
  "version": "0.6.0",
  "description": "Prevents API keys from being pasted into AI chat inputs in plaintext — redacts them and suggests the safe vault placeholder.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["patterns.js", "guard.js"],
      "css": ["guard.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "apikey-vault Guard", "default_popup": "popup.html" }
}
